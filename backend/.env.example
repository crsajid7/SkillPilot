# SkillPilot AI — Backend Configuration

# Server Port
PORT=3001

# Google GenAI / Gemini API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Target multimodal model identifier
# Default: gemma-4-26b-a4b-it
# Supported alternatives if quota or region requires: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemma-4-26b-a4b-it

# Rate Limiting (max requests per 15 minutes per IP)
RATE_LIMIT_MAX=100
